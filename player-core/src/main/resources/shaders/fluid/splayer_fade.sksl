// SPlayer meshes cross-fade as two separately drawn surfaces. This resource is
// intentionally identical to splayer.sksl; the fade is applied to each mesh's
// paint so old and new albums may keep different geometry while overlapping.
uniform float time;
uniform shader cover;

const float TEX_SIZE = 32.0;

float noise(float2 p) {
    return fract(52.9829189 * fract(dot(p, float2(0.06711056, 0.00583715))));
}

half4 main(float2 localCoord) {
    float2 uv = localCoord / TEX_SIZE;
    float2 centered = uv - float2(0.2);
    const float volume = 0.1;
    float angle = time * 0.8 + volume * 2.0;
    float cs = cos(angle);
    float sn = sin(angle);
    float2 finalUV = float2(cs * centered.x - sn * centered.y,
                            sn * centered.x + cs * centered.y)
                     * (1.0 - volume * 2.0) + float2(0.5);
    float3 rgb = float3(cover.eval(finalUV * TEX_SIZE).rgb);
    const float alphaVolume = 0.95;
    rgb *= alphaVolume;
    rgb += (noise(localCoord) - 0.5) / 255.0;
    float vignette = smoothstep(0.8, 0.3, distance(uv, float2(0.5)));
    rgb *= 0.6 + vignette * 0.4;
    return half4(rgb, alphaVolume);
}
